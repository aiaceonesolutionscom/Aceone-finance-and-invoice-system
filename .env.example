# Postgres connection string.
# See README.md "Local database setup" for the commands to create your own
# dev role + database, then paste the resulting connection string here.
DATABASE_URL=postgresql://aceone_dev:CHANGE_ME@localhost:5432/aceone_finance_dev

# Port the Next.js server listens on. cPanel's Node.js app manager sets this
# automatically in production; for local dev it defaults to 3000 if unset.
PORT=3005

NODE_ENV=development
